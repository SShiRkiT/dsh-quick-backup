{
  "name": "dsh-quick-backup",
  "version": "0.2.0",
  "description": "Local-only backup controls and workflow for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "setup.ps1",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SShiRkiT/dsh-quick-backup.git"
  },
  "homepage": "https://github.com/SShiRkiT/dsh-quick-backup#readme",
  "bugs": {
    "url": "https://github.com/SShiRkiT/dsh-quick-backup/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
